# ─────────────────────────────────────────────────────────────
# Nabhindu Technologies – environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit .env.local – these are server-side secrets.
# ─────────────────────────────────────────────────────────────

# Public URL of the website (used for SEO, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# PostgreSQL connection string (Supabase → Project Settings → Database → Connection string → URI)
# Example: postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Random string used to anonymise visitor IPs for rate limiting (any long random text)
IP_HASH_SALT=

# ── Email notifications (Gmail SMTP) ─────────────────────────
# Use a Gmail "App Password" (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nabhindutechnologies@gmail.com
SMTP_PASS=
# Where inquiry notifications are delivered
CONTACT_TO_EMAIL=nabhindutechnologies@gmail.com
# Sender address (must be the SMTP account or an alias it is allowed to send as)
CONTACT_FROM_EMAIL=nabhindutechnologies@gmail.com

# Admin dashboard (/admin)
# Password to log in (at least 8 characters). Keep it secret.
ADMIN_PASSWORD=
# Optional: long random string used to sign login sessions. Changing it logs everyone out.
ADMIN_SESSION_SECRET=

# SEO dashboard (/admin/seo) – Google Search Console service account
# Fill with: node scripts/gsc-env.mjs "path\to\key.json"
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=https://nabhindu.vercel.app/
# Optional: Google Cloud API key restricted to PageSpeed Insights API
PAGESPEED_API_KEY=
